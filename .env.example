# Copy to .env (cp .env.example .env). All values are optional; these are the defaults.
API_PORT=8000

# --- LLM Provider Selection ---
# Option A: LM Studio (recommended for your setup)
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://host.docker.internal:1234
LLM_MODEL=qwen3.5-9b

# Option B: Native Ollama (uncomment if using Ollama instead)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_CTX=8192

# --- Embeddings & RAG Settings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENS=500
CHUNK_OVERLAP=50
TOP_K=5
MAX_UPLOAD_MB=50

# Browser origins allowed by CORS (comma-separated). Defaults match the React dev server on :5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

